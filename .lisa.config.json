{
  "wiki": {
    "source": {
      "path": "wiki"
    }
  },
  "harness": "codex",
  "tracker": "github",
  "source": "github",
  "github": {
    "org": "your-org",
    "repo": "your-project",
    "labels": {
      "build": {
        "ready": "status:ready",
        "claimed": "status:in-progress",
        "blocked": "status:blocked",
        "done": {
          "dev": "status:done",
          "staging": "status:done",
          "production": "status:done"
        }
      },
      "prd": {
        "draft": "prd-draft",
        "ready": "prd-ready",
        "in_review": "prd-in-review",
        "blocked": "prd-blocked",
        "ticketed": "prd-ticketed",
        "shipped": "prd-shipped",
        "sentinel": "prd-intake-feedback"
      }
    }
  },
  "deploy": {
    "branches": {
      "production": "main"
    }
  },
  "gates": {
    "runner": "npm run",
    "traceability": {
      "push": "required",
      "pull-request": {
        "level": "required",
        "run": "check:work-item:pr"
      }
    },
    "type-correctness": {
      "push": "required",
      "pull-request": "required"
    },
    "code-style-slow": {
      "push": "required",
      "pull-request": "required"
    },
    "dead-code": {
      "push": {
        "level": "required",
        "run": "knip:check"
      },
      "pull-request": {
        "level": "required",
        "run": "knip:check"
      }
    },
    "test-correctness": {
      "push": {
        "level": "required",
        "run": "test:cov:unit"
      },
      "pull-request": {
        "level": "required",
        "run": "test:cov"
      }
    },
    "coverage-adequacy": {
      "push": {
        "level": "required",
        "run": "test:cov:unit"
      }
    },
    "test-integration": {
      "push": "required",
      "pull-request": "required"
    },
    "code-style": {
      "pull-request": "required"
    },
    "build-integrity": {
      "pull-request": "required"
    },
    "format-conformance": {
      "pull-request": "required"
    },
    "test-meaningfulness": {
      "pull-request": "required"
    },
    "test-node-suites": {
      "pull-request": "required"
    }
  },
  "quality": {
    "mutation": {
      "strykerThresholds": {
        "high": 80,
        "low": 60,
        "break": 60
      }
    }
  }
}
