{
  "devDependencies": {
    "@ast-grep/cli": "^0.40.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "husky": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@codyswann/lisa": "4.69.1",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
