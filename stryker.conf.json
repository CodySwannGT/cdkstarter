{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "util/**/*.ts",
    "bin/**/*.ts",
    "config/**/*.ts",
    "resources/**/*.js"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 20
}
